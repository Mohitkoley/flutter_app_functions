<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:appfn="http://schemas.android.com/apk/androidx.appfunctions">

    <application>
        <!--
          FlutterAppFunctionsService is generated by the appfunctions KSP
          processor from BaseFlutterAppFunctionsService, which carries the
          @AppFunctionServiceEntryPoint annotation. The service extends the
          platform android.app.appfunctions.AppFunctionService (API 36+), so
          it is disabled by default and enabled by res/values-v36.
        -->
        <service
            android:name="com.mohitkoley.flutter_app_functions.FlutterAppFunctionsService"
            android:enabled="@bool/enableFlutterAppFunctionsService"
            android:exported="true"
            android:permission="android.permission.BIND_APP_FUNCTION_SERVICE"
            tools:targetApi="36">

            <!--
              The rich metadata document generated from
              @AppFunctionServiceEntryPoint(appFunctionXmlFileName = "flutter_app_functions").
              app_functions.xml is the legacy indexer's document; the KSP
              processor still emits it (empty, since every function now lives
              on the entry point) so the property has a valid target.
            -->
            <property
                android:name="android.app.appfunctions.v2"
                android:value="flutter_app_functions.xml" />
            <property
                android:name="android.app.appfunctions"
                android:value="app_functions.xml" />
            <property
                android:name="android.app.appfunctions.schema"
                android:value="app_functions_schema.xsd" />

            <intent-filter>
                <action android:name="android.app.appfunctions.AppFunctionService" />
            </intent-filter>
        </service>

        <property
            android:name="android.app.appfunctions.app_metadata"
            android:resource="@xml/app_metadata" />
    </application>
</manifest>
